      },
      "maxItems": 8
    },
    "feedback_text": {
      "type": "string",
      "pattern": "^[\\s\\S]{0,1200}$"
    }
  },
  "required": [
    "is_trojan",
    "confidence",
    "suspect_nodes",
    "feedback_text"
  ]
}

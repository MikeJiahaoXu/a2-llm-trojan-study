{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "is_trojan": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "suspect_nodes": {
      "type": "array",
      "items": {
        "type": "string",
